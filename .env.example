# 이 파일을 .env로 복사해서 쓰세요. (.env는 깃에 올라가지 않습니다)

# ===== 실행 모드 =====
# mock: API 키 없이 규칙 기반으로 전체 흐름 확인 / llm: 실제 LLM 사용
FAE_MODE=mock
# "제공자:모델" 형식 (langchain init_chat_model)
LLM_MODEL=openai:gpt-5.4-mini
OPENAI_API_KEY=
# Claude를 쓰려면: pip install langchain-anthropic 후 LLM_MODEL=anthropic:<모델 이름>
# ANTHROPIC_API_KEY=

# ===== 도구 호출 방식 =====
# local: 함수를 직접 호출 (기본) / mcp: MCP 서버(stdio)를 거쳐 호출 (langchain[mcp] 필요, 베타 API)
TOOL_MODE=local

# ===== 사람 승인 =====
# true면 승인 단계를 자동 통과 (평가·테스트용)
AUTO_APPROVE=false
# 검수 미통과 시 재분석 최대 횟수
MAX_QA_RETRIES=2

# ===== ngspice =====
# PATH에 없으면 실행 파일 전체 경로 (ngspice_con.exe가 있으면 그것, 없으면 ngspice.exe)
# 예: C:\tools\Spice64\bin\ngspice_con.exe
NGSPICE_PATH=
